<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.easy.messaging</groupId>
    <artifactId>easy-message</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>message-core</module>
        <module>message-eventhub</module>
        <module>message-autoconfigure</module>
        <module>message-starter</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bom_version_to_target>1.3.2</bom_version_to_target>
        <spring-boot.version>3.5.5</spring-boot.version>
        <starter-project.version>1.0-SNAPSHOT</starter-project.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- manage azure sdk-->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${bom_version_to_target}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.easy.messaging</groupId>
                <artifactId>message-core</artifactId>
                <version>${starter-project.version}</version>
                <scope>compile</scope>
            </dependency>

            <dependency>
                <groupId>com.easy.messaging</groupId>
                <artifactId>message-eventhub</artifactId>
                <version>${starter-project.version}</version>
                <scope>compile</scope>
            </dependency>

            <dependency>
                <groupId>com.easy.messaging</groupId>
                <artifactId>message-autoconfigure</artifactId>
                <version>${starter-project.version}</version>
                <scope>compile</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

    </build>

</project>